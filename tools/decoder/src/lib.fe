//! A decoder for the toml-test suite (https://github.com/toml-lang/toml-test):
//! reads TOML on stdin and writes its tagged JSON form to stdout. Invalid
//! TOML exits with status 1 and an error message.

use core::MemBuffer
use lutz::{Document, Key, Kind, NONE}
use std::io::{Stdio, print_buffer, read_to_end}

pub fn main() -> i32 uses (io: mut Stdio) {
    var input = MemBuffer::empty()
    var out = MemBuffer::empty()
    read_to_end(mut input)
    let doc = lutz::parse(input.span(), 0, input.len().downcast_unchecked())
    let code = if doc.ok() {
        emit(doc, doc.root(), mut out)
        out.push(10)
        0
    } else {
        doc.push_error(mut out)
        out.push(10)
        1
    }
    print_buffer(out)
    code
}

fn push_text<T: Key>(_ buf: mut MemBuffer, _ text: T) {
    let bytes = text.bytes()
    var i: usize = 0
    while i < T::SIZE {
        buf.push(bytes[i])
        i += 1
    }
}

fn emit(_ doc: Document, _ node: u64, _ out: mut MemBuffer) {
    match doc.kind(node) {
        Kind::Table => {
            out.push(123)
            var child = doc.first(node)
            while child != NONE {
                if child != doc.first(node) {
                    out.push(44)
                }
                emit_string(doc, doc.key(child), mut out)
                out.push(58)
                emit(doc, child, mut out)
                child = doc.next(child)
            }
            out.push(125)
        }
        Kind::Array => {
            out.push(91)
            var child = doc.first(node)
            while child != NONE {
                if child != doc.first(node) {
                    out.push(44)
                }
                emit(doc, child, mut out)
                child = doc.next(child)
            }
            out.push(93)
        }
        Kind::String => emit_scalar(doc, node, "string", mut out)
        Kind::Integer => {
            push_text(mut out, "{\"type\":\"integer\",\"value\":\"")
            doc.push_integer(node, mut out)
            push_text(mut out, "\"}")
        }
        Kind::Float => emit_scalar(doc, node, "float", mut out)
        Kind::Boolean => {
            if doc.boolean(node) {
                push_text(mut out, "{\"type\":\"bool\",")
                push_text(mut out, "\"value\":\"true\"}")
            } else {
                push_text(mut out, "{\"type\":\"bool\",")
                push_text(mut out, "\"value\":\"false\"}")
            }
        }
        Kind::OffsetDateTime => emit_scalar(doc, node, "datetime", mut out)
        Kind::LocalDateTime => emit_scalar(doc, node, "datetime-local", mut out)
        Kind::LocalDate => emit_scalar(doc, node, "date-local", mut out)
        Kind::LocalTime => emit_scalar(doc, node, "time-local", mut out)
    }
}

fn emit_scalar<T: Key>(_ doc: Document, _ node: u64, _ kind: T, _ out: mut MemBuffer) {
    push_text(mut out, "{\"type\":\"")
    push_text(mut out, kind)
    push_text(mut out, "\",\"value\":")
    emit_string(doc, doc.value(node), mut out)
    out.push(125)
}

/// A JSON string of the document text in `span`.
fn emit_string(_ doc: Document, _ span: lutz::Span, _ out: mut MemBuffer) {
    out.push(34)
    var i: u64 = 0
    while i < span.len {
        let c = doc.byte_at(span.start + i)
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
        } else if c < 32 || c == 127 {
            push_text(mut out, "\\u00")
            out.push(hex_digit(c >> 4))
            out.push(hex_digit(c & 15))
        } else {
            out.push(c)
        }
        i += 1
    }
    out.push(34)
}

fn hex_digit(_ value: u8) -> u8 {
    if value < 10 { 48 + value } else { 87 + value }
}
